<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GmEnabled Condition="'$(GmEnabled)' == ''">true</GmEnabled>
    <DefineConstants Condition="'$(GmEnabled)' == 'true'">$(DefineConstants);GESTURE_MANAGER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="TestHost.cs" />
    <Compile Include="..\..\Editor\Tools\GestureManagerMenuTools.cs" Link="GestureManagerMenuTools.cs" />
    <Compile Include="..\..\Editor\Tools\GestureManagerPaging.cs" Link="GestureManagerPaging.cs" />
    <Compile Include="..\..\Editor\MCP\SimpleJson.cs" Link="SimpleJson.cs" />
    <Compile Include="..\..\SDK\AgentToolAttribute.cs" Link="AgentToolAttribute.cs" />
  </ItemGroup>
</Project>
